{
  "name": "chronocity",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node --test packages/core/test.ts",
    "typecheck": "tsc -p packages/core && tsc -p packages/bake && tsc -p packages/web",
    "dev": "vite packages/web",
    "build": "vite build packages/web --base ./",
    "preview": "vite preview packages/web --base ./",
    "bake": "node packages/bake/bake.ts",
    "drive": "node scripts/drive.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "typescript": "^7.0.2"
  }
}
